      m_Items: []
  - m_Id: 2627758530561
    m_Localized: "\u0E1F\u0E34\u0E27\u0E0A\u0E31\u0E19 Magnum + Star Ring \u2014 \u0E25\u0E39\u0E01\u0E41\u0E01\u0E49\u0E27\u0E27\u0E19\u0E23\u0E2D\u0E1A\u0E15\u0E31\u0E27\u0E41\u0E25\u0E30\u0E22\u0E34\u0E07\u0E01\u0E23\u0E30\u0E2A\u0E38\u0E19\u0E43\u0E2A\u0E48\u0E28\u0E31\u0E15\u0E23\u0E39\u0E43\u0E01\u0E25\u0E49\u0E2A\u0E38\u0E14\u0E44\u0E1B\u0E14\u0E49\u0E27\u0E22"
