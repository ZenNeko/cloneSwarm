      m_Items: []
  - m_Id: 2627758530583
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07\u0E1B\u0E37\u0E19\u0E1E\u0E01 \u2014 \u0E22\u0E34\u0E07\u0E23\u0E31\u0E27\u0E40\u0E1B\u0E47\u0E19\u0E0A\u0E38\u0E14 \u0E41\u0E23\u0E07\u0E02\u0E36\u0E49\u0E19\u0E41\u0E25\u0E30\u0E16\u0E35\u0E48\u0E02\u0E36\u0E49\u0E19\u0E01\u0E27\u0E48\u0E32\u0E40\u0E14\u0E34\u0E21\u0E21\u0E32\u0E01"
    m_Metadata:
      m_Items: []
  - m_Id: 2627758530585
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07 Molotov \u2014 \u0E23\u0E30\u0E40\u0E1A\u0E34\u0E14\u0E25\u0E39\u0E01\u0E22\u0E31\u0E01\u0E29\u0E4C\u0E17\u0E34\u0E49\u0E07\u0E2A\u0E23\u0E30\u0E40\u0E1E\u0E25\u0E34\u0E07\u0E01\u0E27\u0E49\u0E32\u0E07\u0E04\u0E49\u0E32\u0E07\u0E44\u0E27\u0E49\u0E01\u0E25\u0E32\u0E07\u0E2A\u0E19\u0E32\u0E21"
    m_Metadata:
      m_Items: []
  - m_Id: 2627758530587
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07 Laser \u2014 \u0E25\u0E33\u0E41\u0E2A\u0E07\u0E40\u0E08\u0E32\u0E30\u0E17\u0E30\u0E25\u0E38\u0E17\u0E31\u0E19\u0E17\u0E35\u0E02\u0E49\u0E32\u0E21\u0E08\u0E2D \u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E23\u0E31\u0E1A\u0E1C\u0E25\u0E08\u0E32\u0E01 \u0E08\u0E33\u0E19\u0E27\u0E19 Projectile \u0E44\u0E14\u0E49"
    m_Metadata:
      m_Items: []
  - m_Id: 2627758530589
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07 Vortex \u2014 \u0E2A\u0E32\u0E22\u0E44\u0E1F\u0E41\u0E25\u0E30\u0E2A\u0E32\u0E22\u0E19\u0E49\u0E33\u0E41\u0E02\u0E47\u0E07\u0E2B\u0E21\u0E38\u0E19\u0E2A\u0E25\u0E31\u0E1A\u0E01\u0E31\u0E19 \u0E2A\u0E32\u0E22\u0E19\u0E49\u0E33\u0E41\u0E02\u0E47\u0E07\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E28\u0E31\u0E15\u0E23\u0E39\u0E0A\u0E49\u0E32\u0E41\u0E25\u0E30\u0E41\u0E02\u0E47\u0E07"
    m_Metadata:
      m_Items: []
  - m_Id: 2627758530591
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07 Spike \u2014 \u0E40\u0E21\u0E37\u0E48\u0E2D\u0E40\u0E14\u0E49\u0E07\u0E01\u0E31\u0E1A\u0E01\u0E33\u0E41\u0E1E\u0E07\u0E08\u0E30\u0E41\u0E22\u0E01\u0E23\u0E48\u0E32\u0E07\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E2D\u0E07\u0E2B\u0E19\u0E32\u0E21\u0E40\u0E09\u0E35\u0E22\u0E07\u0E2D\u0E2D\u0E01"
    m_Metadata:
      m_Items: []
  - m_Id: 2627762724865
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07 Grenade \u2014 \u0E27\u0E32\u0E07\u0E23\u0E30\u0E40\u0E1A\u0E34\u0E14\u0E2B\u0E25\u0E32\u0E22\u0E25\u0E39\u0E01\u0E23\u0E2D\u0E1A\u0E15\u0E31\u0E27 \u0E41\u0E15\u0E48\u0E25\u0E30\u0E25\u0E39\u0E01\u0E41\u0E15\u0E01\u0E40\u0E1B\u0E47\u0E19\u0E25\u0E39\u0E01\u0E22\u0E48\u0E2D\u0E22\u0E2D\u0E35\u0E01\u0E0A\u0E31\u0E49\u0E19"
    m_Metadata:
      m_Items: []
  - m_Id: 2627762724867
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07 Orbiter \u2014 \u0E25\u0E39\u0E01\u0E41\u0E01\u0E49\u0E27\u0E27\u0E19\u0E2A\u0E2D\u0E07\u0E27\u0E07\u0E0B\u0E49\u0E2D\u0E19 \u0E04\u0E23\u0E2D\u0E1A\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E23\u0E2D\u0E1A\u0E15\u0E31\u0E27\u0E44\u0E14\u0E49\u0E41\u0E19\u0E48\u0E19\u0E02\u0E36\u0E49\u0E19"
    m_Metadata:
      m_Items: []
  - m_Id: 2627762724869
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07 Lightning Chain \u2014 \u0E01\u0E23\u0E30\u0E42\u0E14\u0E14\u0E15\u0E48\u0E2D\u0E44\u0E14\u0E49\u0E44\u0E01\u0E25\u0E02\u0E36\u0E49\u0E19 \u0E41\u0E25\u0E30\u0E17\u0E34\u0E49\u0E07\u0E27\u0E07\u0E2A\u0E32\u0E22\u0E1F\u0E49\u0E32\u0E44\u0E27\u0E49\u0E17\u0E35\u0E48\u0E17\u0E38\u0E01\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22"
    m_Metadata:
      m_Items: []
  - m_Id: 2627762724871
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07 Big AoE \u2014 \u0E23\u0E30\u0E40\u0E1A\u0E34\u0E14\u0E22\u0E31\u0E01\u0E29\u0E4C\u0E2D\u0E31\u0E1B\u0E40\u0E01\u0E23\u0E14 EXP \u0E17\u0E35\u0E48\u0E15\u0E01\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E19\u0E27\u0E07 \u0E41\u0E25\u0E30\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E14\u0E32\u0E40\u0E21\u0E08\u0E43\u0E2B\u0E49\u0E17\u0E31\u0E49\u0E07\u0E17\u0E35\u0E21\u0E0A\u0E31\u0E48\u0E27\u0E04\u0E23\u0E39\u0E48"
    m_Metadata:
      m_Items: []
  - m_Id: 2627762724873
    m_Localized: "\u0E23\u0E48\u0E32\u0E07\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E02\u0E2D\u0E07 Big Cannon \u2014 \u0E01\u0E23\u0E30\u0E2A\u0E38\u0E19\u0E43\u0E2B\u0E0D\u0E48\u0E02\u0E36\u0E49\u0E19 \u0E41\u0E23\u0E07\u0E02\u0E36\u0E49\u0E19 \u0E41\u0E25\u0E30\u0E17\u0E30\u0E25\u0E38\u0E44\u0E14\u0E49\u0E25\u0E36\u0E01\u0E01\u0E27\u0E48\u0E32\u0E40\u0E14\u0E34\u0E21"
